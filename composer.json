{
  "name": "tetthys/input",
  "description": "Universal input value resolver and components (PHP 8.3+)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "Tetthys\\Input\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "pestphp/pest": "4.1.3"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Tetthys\\Input\\Adapters\\Laravel\\InputServiceProvider"
      ]
    }
  }
}
